# Copy to .env.local for local dev. Without DATABASE_URL the site renders db/seed.json read-only.

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Password for /admin. Admin is disabled while this is empty.
ADMIN_PASSWORD=

# >= 32 random chars. Signs admin sessions and salts IP hashes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
